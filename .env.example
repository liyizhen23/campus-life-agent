# Copy this file to .env before starting the app locally.
# Never place real secrets in this tracked template.

# Dify Cloud Chatflow application API key.
DIFY_API_KEY=
DIFY_API_BASE_URL=https://api.dify.ai/v1

# AMap key whose service platform is "Web Service".
AMAP_WEB_SERVICE_KEY=

# Generate with: openssl rand -hex 32
# This must match INTERNAL_API_TOKEN in the Dify Chatflow.
INTERNAL_API_TOKEN=

# Local frontend origin and server port.
ALLOWED_ORIGINS=http://localhost:8000
PORT=8000

# Optional local fallback location.
DEFAULT_LONGITUDE=116.3260
DEFAULT_LATITUDE=40.0030
DEFAULT_LOCATION_NAME=清华大学
REQUEST_TIMEOUT_SECONDS=20
